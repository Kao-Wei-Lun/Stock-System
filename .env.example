MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=quantvision
MYSQL_CHARSET=utf8mb4
# Optional explicit client paths when MySQL tools are not available on PATH.
MYSQLDUMP_PATH=
MYSQL_CLIENT_PATH=
# Automatic backups use the critical scope: all schemas and personal data are
# included, while rebuildable OHLCV/chip history rows are omitted.
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_SCOPE=critical
AUTO_BACKUP_INTERVAL_HOURS=24
AUTO_BACKUP_MAX_AGE_HOURS=36
AUTO_BACKUP_INITIAL_DELAY_SECONDS=300
AUTO_BACKUP_TIMEOUT_SECONDS=1800
AUTO_BACKUP_RETENTION_DAYS=30
AUTO_BACKUP_KEEP_MINIMUM=7
OPERATIONAL_METRICS_INTERVAL_SECONDS=60
OPERATIONAL_METRICS_QUALITY_INTERVAL_SECONDS=300
OPERATIONAL_METRICS_STARTUP_DELAY_SECONDS=15
LOG_FILE_ENABLED=true
LOG_FILE_PATH=log/backend.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=14
LOG_RETENTION_DAYS=14
DB_AUTO_MIGRATE=true
FRONTEND_PORT=5173
APP_PORT=8001
# Personal-use safe defaults. Set hosts to 0.0.0.0 and ALLOW_LAN_ACCESS=true only for intentional LAN access.
APP_BIND_HOST=127.0.0.1
FRONTEND_BIND_HOST=127.0.0.1
DOCKER_BIND_HOST=127.0.0.1
ALLOW_LAN_ACCESS=false
# Optional when LAN access is enabled. Use the smallest subnet that contains
# your own devices; access through a literal private IP (not a public hostname).
LAN_ALLOWED_NETWORKS=
# Exact browser origins, comma-separated. Include the production /app origin
# (for example http://192.168.1.10:8001) and any frontend development origin.
LAN_ALLOWED_ORIGINS=
# Required only when ALLOW_LAN_ACCESS=true. Generate a unique value, for example:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never place this token in a URL, frontend build variable, log, or Git commit.
LAN_ACCESS_TOKEN=
STARTUP_DOWNLOAD_ENABLED=false
STARTUP_DOWNLOAD_DELAY_SECONDS=2.5
INSTITUTIONAL_AUTO_SYNC_ENABLED=true
TAIWAN_CHIP_AUTO_SYNC_ENABLED=true
LATEST_DATA_SYNC_ON_STARTUP=true
LATEST_DATA_SYNC_PERIOD=1y
LATEST_DATA_SYNC_INTERVAL=1d
ALERT_EVALUATOR_ENABLED=true
ALERT_POLL_INTERVAL_SECONDS=30
MARKET_INTELLIGENCE_SYNC_ENABLED=true
MARKET_INTELLIGENCE_STARTUP_SYNC=true
MARKET_INTELLIGENCE_SYNC_INTERVAL_SECONDS=3600
MARKET_INTELLIGENCE_STARTUP_DELAY_SECONDS=12
APP_TIMEZONE=Asia/Taipei
DAILY_LATEST_SYNC_TIME=18:10
TRACKED_MARKET_SYNC_TIME=13:45
TAIWAN_CHIP_SYNC_TIME=18:10
FUBON_MARKET_SNAPSHOT_SYNC_TIME=18:10
INSTITUTIONAL_SYNC_TIME=19:00
PAPER_MARGIN_SYNC_TIME=18:10
REALTIME_POLL_INTERVAL_SECONDS=15
REALTIME_PER_TICKER_DELAY_SECONDS=0.2
OVERSEAS_QUOTE_REFRESH_ENABLED=true
OVERSEAS_QUOTE_MAX_CONCURRENCY=2
OVERSEAS_QUOTE_SCAN_INTERVAL_SECONDS=15
OVERSEAS_QUOTE_ACTIVE_INTERVAL_SECONDS=60
OVERSEAS_QUOTE_WATCHLIST_INTERVAL_SECONDS=300
OVERSEAS_QUOTE_CRYPTO_INTERVAL_SECONDS=180
OVERSEAS_QUOTE_CLOSED_INTERVAL_SECONDS=1800
OVERSEAS_QUOTE_MANUAL_MIN_INTERVAL_SECONDS=10
REALTIME_QUOTE_PERSIST_INTERVAL_MS=500
REALTIME_QUOTE_PERSIST_CAPACITY=500
REALTIME_QUOTE_PERSIST_ASYNC_ENABLED=true
VITE_REALTIME_BATCHING_ENABLED=true
REALTIME_POLL_STARTUP_DELAY_SECONDS=5
FUBON_WS_SESSION_REFRESH_SECONDS=30
FUBON_MAINTENANCE_RESTART_ENABLED=false
FUBON_MAINTENANCE_RESTART_TIME=08:00
FUBON_WS_UNHEALTHY_GRACE_SECONDS=300
FUBON_WS_HEALTH_CHECK_INTERVAL_SECONDS=30
FUBON_MAINTENANCE_RESTART_WEEKDAYS_ONLY=true
LATEST_SYNC_STARTUP_DELAY_SECONDS=15
FUBON_MARKET_SNAPSHOT_STARTUP_DELAY_SECONDS=20
TW_FULL_HISTORY_STARTUP_DELAY_SECONDS=240
PAPER_MARGIN_STARTUP_DELAY_SECONDS=25
PAPER_BOT_AUTOSTART_ENABLED=true
PAPER_BOT_AUTOSTART_WARMUP_TIMEOUT_SECONDS=120
PAPER_BOT_AUTOSTART_MAX_ATTEMPTS=3
PAPER_BOT_AUTOSTART_RETRY_DELAY_SECONDS=15
ALERT_STARTUP_DELAY_SECONDS=10
FUBON_HISTORY_MAX_RANGE_DAYS=364
FUBON_HISTORY_CHUNK_DELAY_SECONDS=0.3
FUBON_RATE_LIMIT_RETRY_DELAYS_SECONDS=5,15,30
FUTOPT_RECORDER_ENABLED=true
FUTOPT_BACKGROUND_MAX_CONCURRENT_REFRESHES=2
FUTOPT_RECORDER_SYMBOLS=TXF,TMF
FUTOPT_RECORDER_POLL_SECONDS=30
FUTOPT_RECORDER_BACKFILL_INTERVAL_SECONDS=300
FUTOPT_BACKGROUND_STALE_SECONDS=90
FUTOPT_BACKGROUND_EMPTY_WAIT_SECONDS=8
ASSET_QUOTE_REFRESH_TIMEOUT_SECONDS=8
ASSET_QUOTE_REFRESH_MAX_CONCURRENCY=6
ASSET_QUOTE_CACHE_TTL_SECONDS=15
BACKTEST_EXECUTOR_ENABLED=true
BACKTEST_TIMEOUT_SECONDS=30
PAPER_MARGIN_AUTO_SYNC_ENABLED=true
TW_FULL_HISTORY_SYNC_ENABLED=true
TW_FULL_HISTORY_SYNC_START=14:00
TW_FULL_HISTORY_SYNC_STOP=08:00
TW_FULL_HISTORY_PERIOD=max
TW_FULL_HISTORY_INCREMENTAL_PERIOD=5d
TW_FULL_HISTORY_INTERVALS=1d
TW_FULL_HISTORY_DELAY_SECONDS=0.8
TW_FULL_HISTORY_TICKER_DELAY_SECONDS=2.0
TW_FULL_HISTORY_INCLUDE_ETF=true
TW_FULL_HISTORY_RETRY_INTERVAL_SECONDS=1800
TW_FULL_HISTORY_RETRY_MIN_LATEST_COVERAGE_PCT=99
FRONTEND_DEV_URL=http://localhost:5173
APP_ENCRYPT_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Daily AI report email delivery. For Gmail, create an app password:
# Google Account -> Security -> 2-Step Verification -> App passwords.
DAILY_REPORT_EMAIL_TO=your_email@example.com
DAILY_REPORT_WAIT_FOR_DATA_READY=true
DAILY_REPORT_DATA_READY_TIMEOUT_MINUTES=180
DAILY_REPORT_DATA_READY_CHECK_INTERVAL_SECONDS=300
DAILY_REPORT_MIN_STOCK_KLINE_READY_PCT=80
DAILY_REPORT_AI_ANALYSIS_ENABLED=auto
DAILY_REPORT_AI_MODEL=gpt-5
DAILY_REPORT_AI_MAX_TICKERS=18
DAILY_REPORT_AI_HISTORY_DAYS=22
DAILY_REPORT_AI_MAX_OUTPUT_TOKENS=2200
DAILY_REPORT_AI_TIMEOUT_SECONDS=90
DAILY_REPORT_CODEX_ANALYSIS_PATH=
OPENAI_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_FALLBACK_PORTS=465,587
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
SMTP_FROM=your_gmail_address@gmail.com
